{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP-IDF Debug",
      "type": "gdbtarget",
      "request": "attach",
      "program": "${workspaceFolder}/build/${command:espIdf.getProjectName}.elf",
      "gdb": "${command:espIdf.getToolchainGdb}",
      "target": {
        "connectCommands": [
          "set remote hardware-watchpoint-limit 2",
          "mon reset halt",
          "flushregs",
          "thb app_main",
          "c"
        ]
      }
    }
  ]
}
